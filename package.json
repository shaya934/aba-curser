{
  "name": "brightpath-aba",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build --webpack && node --import tsx scripts/check-traces.ts",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:generate": "node --env-file-if-exists=.env --import tsx scripts/generate.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "reports:retry": "node --env-file-if-exists=.env --import tsx scripts/retry-reports.ts",
    "reports:worker": "node --env-file-if-exists=.env --import tsx scripts/retry-reports.ts --watch",
    "format": "prettier --write src tests scripts prisma/seed.ts *.ts *.json *.mjs",
    "env:init": "node --import tsx scripts/init-env.ts",
    "setup": "npm run env:init && npm run db:generate && npm run db:migrate && npm run db:seed",
    "config:vercel": "node --env-file-if-exists=.env --import tsx scripts/check-vercel.ts",
    "build:vercel": "npm run config:vercel && npm run build",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "test:storage": "node --env-file-if-exists=.env --import tsx --test tests/storage.s3.integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "6.19.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.0",
    "next": "^16.0.0",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@prisma/internals": "^6.19.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  },
  "engines": {
    "node": "24.x"
  }
}
