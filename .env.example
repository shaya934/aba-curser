DATABASE_URL=postgresql://aba:aba_local_only@localhost:5432/aba?schema=public
APP_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32. Never reuse development keys in production.
STORAGE_KEY=
STORAGE_DIR=./var/private
# Set only for seed. Must be at least 12 characters. Change before sharing an environment.
SEED_PASSWORD=

# Vercel: pooled runtime URL above; direct TLS URL used only by migration commands.
DATABASE_DIRECT_URL=
# Local defaults to local. Vercel must use s3 (never ephemeral local disk).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
# Optional for AWS S3; required by S3-compatible providers. HTTPS origin.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Independent random secret, 32+ characters; Vercel attaches it to cron requests.
CRON_SECRET=
# First-admin command only: set these securely in the operator's environment.
# AGENCY_NAME=
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Alternative: use the existing Supabase integration instead of S3 credentials.
# STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=brightpath-private
# Public provider CA certificate (PEM), when required by hosted PostgreSQL.
DATABASE_SSL_CA=
